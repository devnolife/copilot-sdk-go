# Konfigurasi copilotd. Salin ke .env lalu isi.
#   cp .env.example .env && chmod 600 .env
#
# copilotd tidak membaca berkas ini sendiri. Muat lewat salah satu cara:
#   set -a && source .env && set +a && ./bin/copilotd
#   atau EnvironmentFile= di unit systemd.

# --- Server ---
COPILOTD_ADDR=127.0.0.1:8791
# Kosong = tanpa auth. Isi dengan `openssl rand -hex 24`.
COPILOTD_API_KEY=

# --- Autentikasi GitHub ---
# Classic PAT (ghp_...) dengan scope read:user. Fine-grained (github_pat_...)
# tidak didukung. Kosongkan untuk memakai login `copilot`/`gh` di HOME ini.
TURNITIN_COPILOT_GITHUB_TOKEN=
# Pool multi-akun, dipisah koma. Kalau diisi, mengalahkan _TOKEN di atas.
TURNITIN_COPILOT_GITHUB_TOKENS=

# --- Model ---
TURNITIN_COPILOT_MODEL=
TURNITIN_COPILOT_CHEAP_MODEL=
TURNITIN_COPILOT_HEAVY_MODEL=
TURNITIN_COPILOT_AGENT_MODEL=
# Model cadangan saat kena rate limit, dipisah koma.
TURNITIN_COPILOT_MODEL_FALLBACKS=

# --- Runtime ---
# Tunjuk binary copilot yang benar bila ada beberapa di PATH:
#   COPILOT_CLI_PATH="$(readlink -f "$(npm root -g)/../bin/copilot")"
TURNITIN_COPILOT_CLI_PATH=
TURNITIN_COPILOT_CLI_URL=
TURNITIN_COPILOT_WORKING_DIR=
TURNITIN_COPILOT_BASE_DIR=
TURNITIN_COPILOT_LOG_LEVEL=error
TURNITIN_COPILOT_MAX_CONCURRENCY=2

# --- Timeout (detik) ---
TURNITIN_COPILOT_TIMEOUT=180
TURNITIN_COPILOT_AGENT_TIMEOUT=300

# --- BYOK (opsional; mis. arahkan ke Ollama lokal) ---
TURNITIN_COPILOT_PROVIDER_TYPE=
TURNITIN_COPILOT_PROVIDER_BASE_URL=
TURNITIN_COPILOT_PROVIDER_API_KEY=
TURNITIN_COPILOT_PROVIDER_WIRE_API=completions
