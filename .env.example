# Konfigurasi copilotd. Salin ke .env lalu isi.
#   cp .env.example .env && chmod 600 .env
#
# copilotd tidak membaca berkas ini sendiri. Muat lewat salah satu cara:
#   set -a && source .env && set +a && ./bin/copilotd
#   atau EnvironmentFile= di unit systemd.

# --- Server ---
COPILOTD_ADDR=127.0.0.1:8791
# Kosong = tanpa auth. Isi dengan `openssl rand -hex 24`.
COPILOTD_API_KEY=

# --- Autentikasi GitHub ---
# Token yang didukung Copilot CLI: PAT berbutir (github_pat_...) milik akun pribadi dengan izin akun
# "Copilot Requests", token OAuth (gho_..., mis. dari `gh auth login`), atau token GitHub App pengguna (ghu_...).
# PAT klasik (ghp_...) TIDAK didukung. Kosongkan untuk memakai login `copilot`/`gh` di HOME ini.
TURNITIN_COPILOT_GITHUB_TOKEN=
# Pool multi-akun awal, dipisah koma; entri `login` = akun login tersimpan. Kalau diisi, mengalahkan _TOKEN di
# atas. Setelah `go run ./cmd/akun migrasi`, daftar akun pindah ke $TURNITIN_COPILOT_STATE_DIR/akun.json dan
# dikelola dari admin revisi.studio (Akun Copilot) atau scripts/tambah-akun.sh (README, "Banyak akun").
TURNITIN_COPILOT_GITHUB_TOKENS=
# Folder akun.json (daftar akun, 0600) dan pemakaian.json. Kosong = ~/.local/state/copilotd.
TURNITIN_COPILOT_STATE_DIR=
# Strategi pembagian awal: proporsional (bobot = sisa kuota) | bergiliran | prioritas. Bisa diganti dari admin.
TURNITIN_COPILOT_POOL_STRATEGY=proporsional
# Batas hari catatan pemakaian harian.
TURNITIN_COPILOT_TIMEZONE=Asia/Makassar
# Akun dengan sisa kuota premium <= persen ini hanya dipakai bila tidak ada akun sehat (0 = mati).
TURNITIN_COPILOT_QUOTA_MIN_PERCENT=5
# Interval baca ulang kuota tiap akun, dalam detik (0 = tidak dibaca).
TURNITIN_COPILOT_QUOTA_CHECK_SEC=600

# --- Model ---
# Kosong = default runtime. Tanpa nama model dari pemanggil: tier utama -> MODEL, cheap -> CHEAP_MODEL,
# heavy (IDE Tugas core) -> HEAVY_MODEL, agen -> AGENT_MODEL; tier yang kosong ikut MODEL.
TURNITIN_COPILOT_MODEL=
TURNITIN_COPILOT_CHEAP_MODEL=
TURNITIN_COPILOT_HEAVY_MODEL=
TURNITIN_COPILOT_AGENT_MODEL=
# Model cadangan bila model tier gagal di semua akun (hanya permintaan tanpa nama model), dipisah koma.
TURNITIN_COPILOT_MODEL_FALLBACKS=

# --- Runtime ---
# Tunjuk binary copilot yang benar bila ada beberapa di PATH:
#   COPILOT_CLI_PATH="$(readlink -f "$(npm root -g)/../bin/copilot")"
TURNITIN_COPILOT_CLI_PATH=
TURNITIN_COPILOT_CLI_URL=
TURNITIN_COPILOT_WORKING_DIR=
TURNITIN_COPILOT_BASE_DIR=
TURNITIN_COPILOT_LOG_LEVEL=error
TURNITIN_COPILOT_MAX_CONCURRENCY=2

# --- Timeout (detik) ---
TURNITIN_COPILOT_TIMEOUT=180
# AGENT_TIMEOUT + 2 menit = batas tulis server HTTP untuk SEMUA respons (aliran generate IDE core butuh 540 dtk → ≥ 480).
TURNITIN_COPILOT_AGENT_TIMEOUT=480

# --- BYOK (opsional; mis. arahkan ke Ollama lokal) ---
TURNITIN_COPILOT_PROVIDER_TYPE=
TURNITIN_COPILOT_PROVIDER_BASE_URL=
TURNITIN_COPILOT_PROVIDER_API_KEY=
TURNITIN_COPILOT_PROVIDER_WIRE_API=completions
